audit=false
fund=false
prefer-offline=true
progress=false
loglevel=warn

# Skip Chromium/Puppeteer binary download — Render provides its own Chromium.
# This cuts ~100MB from install time on every cold deploy.
# The CHROMIUM_EXECUTABLE_PATH env var points to Render's system Chromium.
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_SKIP_DOWNLOAD=true
